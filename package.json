{
  "name": "meptos",
  "version": "2.0.0",
  "description": "Modern TypeScript rewrite of Zepto.js — jQuery-compatible DOM library for evergreen browsers",
  "main": "./dist/meptos.umd.cjs",
  "module": "./dist/meptos.js",
  "types": "./dist/meptos.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/meptos.d.ts",
        "default": "./dist/meptos.js"
      },
      "require": {
        "types": "./dist/meptos.d.ts",
        "default": "./dist/meptos.umd.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/src/mepto.d.ts",
        "default": "./dist/esm/mepto.js"
      }
    },
    "./event": {
      "import": {
        "types": "./dist/src/event.d.ts",
        "default": "./dist/esm/event.js"
      }
    },
    "./ajax": {
      "import": {
        "types": "./dist/src/ajax.d.ts",
        "default": "./dist/esm/ajax.js"
      }
    },
    "./hotkey": {
      "import": {
        "types": "./dist/src/hotkey.d.ts",
        "default": "./dist/esm/hotkey.js"
      }
    },
    "./fx": {
      "import": {
        "types": "./dist/src/fx.d.ts",
        "default": "./dist/esm/fx.js"
      }
    },
    "./fx-methods": {
      "import": {
        "types": "./dist/src/fx_methods.d.ts",
        "default": "./dist/esm/fx_methods.js"
      }
    },
    "./data": {
      "import": {
        "types": "./dist/src/data.d.ts",
        "default": "./dist/esm/data.js"
      }
    },
    "./selector": {
      "import": {
        "types": "./dist/src/selector.d.ts",
        "default": "./dist/esm/selector.js"
      }
    },
    "./callbacks": {
      "import": {
        "types": "./dist/src/callbacks.d.ts",
        "default": "./dist/esm/callbacks.js"
      }
    },
    "./deferred": {
      "import": {
        "types": "./dist/src/deferred.d.ts",
        "default": "./dist/esm/deferred.js"
      }
    },
    "./form": {
      "import": {
        "types": "./dist/src/form.d.ts",
        "default": "./dist/esm/form.js"
      }
    },
    "./detect": {
      "import": {
        "types": "./dist/src/detect.d.ts",
        "default": "./dist/esm/detect.js"
      }
    },
    "./stack": {
      "import": {
        "types": "./dist/src/stack.d.ts",
        "default": "./dist/esm/stack.js"
      }
    },
    "./touch": {
      "import": {
        "types": "./dist/src/touch.d.ts",
        "default": "./dist/esm/touch.js"
      }
    },
    "./gesture": {
      "import": {
        "types": "./dist/src/gesture.d.ts",
        "default": "./dist/esm/gesture.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/*.test.ts",
    "!src/*.spec.ts",
    "skills/**/*.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/meptos.js",
    "./dist/meptos.umd.cjs",
    "./dist/esm/*.js"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "vite build && npm run build:esm",
    "build:esm": "node tools/build-esm.mjs",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run killports && npm test && npx playwright test test/e2e/unit-suite.spec.ts --project=chromium",
    "lint": "eslint .",
    "lint:fast": "oxlint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:file": "prettier --write",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit",
    "typecheck:ts5": "node node_modules/typescript/bin/tsc --noEmit",
    "prepare": "node -e \"require('fs').existsSync('.husky') && require('child_process').execSync('npx husky install', {stdio: 'inherit'})\"",
    "size": "npm run build && size-limit",
    "size:check": "size-limit",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run size:check",
    "prepublishOnly": "npm test && npm run build && npm run size:check",
    "killports": "kill-port $(seq -s ' ' 3000 3099)",
    "themekit:build": "go build -o vendor/themekit/bin/theme ./vendor/themekit/... 2>&1 | head -n 20; echo \"(Go required; binary at vendor/themekit/bin/theme; also see oreoorbitz/themekit fork)\"",
    "themekit": "node tools/themekit.mjs"
  },
  "keywords": [
    "jquery",
    "mepto",
    "dom",
    "ajax",
    "events",
    "typescript",
    "migration",
    "vanilla-js"
  ],
  "author": "Orion Holmes (https://github.com/oreoorbitz)",
  "license": "MIT",
  "homepage": "https://oreoorbitz.github.io/Mepto/",
  "repository": {
    "type": "git",
    "url": "https://github.com/oreoorbitz/Mepto.git"
  },
  "bugs": {
    "url": "https://github.com/oreoorbitz/Mepto/issues"
  },
  "engines": {
    "node": "24.x"
  },
  "browserslist": [
    "last 3 Chrome versions",
    "last 3 Firefox versions",
    "last 3 Safari versions",
    "last 3 Edge versions",
    "not IE 11"
  ],
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@types/node": "^24.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.0.0",
    "husky": "^8.0.3",
    "jsdom": "^29.1.0",
    "kill-port": "^2.0.1",
    "lint-staged": "^15.1.0",
    "oxlint": "^1.24.1",
    "prettier": "^3.6.2",
    "size-limit": "^11.0.0",
    "typescript": "^5.9.0",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.0",
    "vitest": "^1.0.0"
  },
  "size-limit": [
    {
      "path": "dist/meptos.js",
      "limit": "17 KB"
    },
    {
      "path": "dist/meptos.umd.cjs",
      "limit": "18 KB"
    }
  ],
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs,jsx}": [
      "oxlint --fix"
    ],
    "*.{ts,js,json,md,css,html}": [
      "prettier --write"
    ]
  }
}
