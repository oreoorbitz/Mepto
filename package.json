{
  "name": "meptos",
  "version": "2.0.0",
  "description": "Modern TypeScript fork of mepto.js - jQuery-compatible library with migration tools",
  "main": "./dist/meptos.umd.cjs",
  "module": "./dist/meptos.js",
  "types": "./dist/meptos.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/meptos.d.ts",
        "default": "./dist/meptos.js"
      },
      "require": {
        "types": "./dist/meptos.d.ts",
        "default": "./dist/meptos.umd.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "tools"
  ],
  "bin": {
    "mepto": "./tools/cli/bin/mepto.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:all": "vite build",
    "build:watch": "tsc && vite build --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run killports && npm test && npx playwright test test/e2e/unit-suite.spec.ts --project=chromium",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:file": "prettier --write",
    "typecheck": "tsc --noEmit",
    "prepare": "husky install",
    "size": "npm run build && size-limit",
    "prepublishOnly": "npm run build && npm test",
    "killports": "kill-port $(seq -s ' ' 3000 3099)"
  },
  "keywords": [
    "jquery",
    "mepto",
    "dom",
    "ajax",
    "events",
    "typescript",
    "migration",
    "vanilla-js"
  ],
  "author": "Mepto Contributors",
  "license": "MIT",
  "homepage": "https://github.com/mepto/meptos#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mepto/meptos.git"
  },
  "bugs": {
    "url": "https://github.com/mepto/meptos/issues"
  },
  "engines": {
    "node": "24.x"
  },
  "browserslist": [
    "last 3 Chrome versions",
    "last 3 Firefox versions",
    "last 3 Safari versions",
    "last 3 Edge versions",
    "not IE 11"
  ],
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^8.0.3",
    "jsdom": "^29.1.0",
    "lint-staged": "^15.1.0",
    "prettier": "^3.1.0",
    "size-limit": "^11.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.0",
    "vitest": "^1.0.0"
  },
  "size-limit": [
    {
      "path": "dist/meptos.js",
      "limit": "15 KB"
    },
    {
      "path": "dist/meptos.umd.cjs",
      "limit": "15 KB"
    }
  ],
  "lint-staged": {
    "*.{ts,js,json,md,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "kill-port": "^2.0.1"
  }
}
