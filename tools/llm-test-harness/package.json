{
  "name": "@mepto/llm-test-harness",
  "version": "1.0.0",
  "description": "LLM Testing Harness for Mepto.js - secure browser-based code execution",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mepto-test": "./bin/mepto-test.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node bin/mepto-test.js --validate --code=\"$('.test').length\""
  },
  "dependencies": {
    "commander": "^11.1.0",
    "puppeteer": "^21.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
